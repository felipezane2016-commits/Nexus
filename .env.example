# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Sem estas variáveis o sistema mostra a tela
# "Sistema ainda não ligado ao banco". (Demonstração com dados fictícios só
# com VITE_DEMO=1, e nunca junto com as chaves abaixo.)
#
# A chave abaixo é a PÚBLICA (anon / publishable). Nunca coloque aqui a
# service_role / secret: ela ignora todas as permissões do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
